# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# Database Connections (Tri-Storage Architecture)
# =============================================================================
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_db?schema=public"

# MongoDB connection string (Mongoose + Atlas Search)
MONGODB_URL="mongodb+srv://user:password@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority"

# Redis connection string (ioredis)
REDIS_URL="redis://default:password@localhost:6379"

# =============================================================================
# JWT Authentication Secrets (Min 16 characters each)
# =============================================================================
ACCESS_TOKEN_SECRET="your-super-secret-access-token-key-min-16-chars"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-min-16-chars"

# =============================================================================
# Cart Configuration
# =============================================================================
# Expiration time for active Redis shopping carts in seconds (e.g., 604800 = 7 days)
CART_EXPIRES=604800

# =============================================================================
# SMTP Email Transporter (Nodemailer for OTP & Password Reset)
# =============================================================================
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@ecommerce.com"

# =============================================================================
# Razorpay Payment Gateway (Optional in development, required in production)
# =============================================================================
RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecretHere"
